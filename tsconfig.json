{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "lib": ["ESNext"],
    "types": ["vitest/globals", "node", "@cloudflare/vitest-plugin/types"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "./src/**/*",
    "./test/**/*",
    "./validation/**/*",
    "./worker-configuration.d.ts"
  ]
}
